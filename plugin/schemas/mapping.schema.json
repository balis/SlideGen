{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:mapping",
  "title": "The current curriculum expressed as taxonomy topics (curriculum-mapper output)",
  "type": "object",
  "required": ["lectures"],
  "additionalProperties": false,
  "properties": {
    "lectures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "title", "topics"],
        "additionalProperties": false,
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "basis": {"type": "string", "description": "what the mapping rests on: the title only, or deck slides"},
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["topic", "label", "hours"],
              "additionalProperties": false,
              "properties": {
                "topic": {"type": ["string", "null"], "description": "taxonomy topic id, or null if no topic fits"},
                "label": {"type": "string"},
                "hours": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
