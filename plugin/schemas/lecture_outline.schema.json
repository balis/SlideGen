{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:lecture_outline",
  "title": "Slide-by-slide outline of one lecture, checked against the course plan",
  "type": "object",
  "required": ["lecture", "slides"],
  "additionalProperties": false,
  "properties": {
    "lecture": {"type": "integer", "minimum": 1},
    "title": {"type": "string"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "title", "topic", "kind"],
        "additionalProperties": false,
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "topic": {"type": ["string", "null"], "description": "course topic id; null for title, organisation, dividers and summary"},
          "kind": {"enum": ["reuse", "new"]},
          "reuse": {
            "type": "object", "required": ["deck", "slide"], "additionalProperties": false,
            "properties": {"deck": {"type": "string"}, "slide": {"type": "integer", "minimum": 1}}
          },
          "preview_of": {"type": "integer", "minimum": 1, "description": "the lecture that teaches this topic in depth"},
          "checked": {"type": "boolean", "description": "claims already fact-checked in an earlier build, text unchanged"},
          "content": {"type": "string", "description": "what the slide shows, in one or two sentences"}
        }
      }
    }
  }
}
