{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:trend_discovery",
  "title": "Sources for discovering and explaining trends, without year-over-year measurement (discovery-scout output)",
  "type": "object",
  "required": [
    "group",
    "searched",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "group": {
      "type": "string"
    },
    "searched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "kind",
          "dimensions",
          "organiser",
          "vendor",
          "access",
          "latest"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "engineering_blog",
              "project_proposals",
              "project_releases",
              "specification",
              "platform_release_notes",
              "survey",
              "radar",
              "report",
              "conference_recordings",
              "other"
            ]
          },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "attention",
                "maturity",
                "production_use",
                "limitations"
              ]
            },
            "description": "what the source can show about a trend"
          },
          "organiser": {
            "type": "string"
          },
          "vendor": {
            "type": "boolean",
            "description": "run by a company that sells data products"
          },
          "tech_company": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "engineering blogs: the organization's main business is software or internet services"
          },
          "sector": {
            "type": [
              "string",
              "null"
            ],
            "description": "engineering blogs: the organization's industry"
          },
          "org_size": {
            "enum": [
              "large",
              "medium",
              "small",
              null
            ],
            "description": "engineering blogs: organization size"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "proposals, releases, specifications, release notes: the projects or products covered"
          },
          "access": {
            "type": "string",
            "description": "how to search or harvest it (feed, archive, search URL pattern, API)"
          },
          "latest": {
            "type": "object",
            "required": [
              "url",
              "fetched",
              "date",
              "quote"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "fetched": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
              },
              "quote": {
                "type": "string",
                "description": "verbatim text of a recent item, from the downloaded page"
              }
            }
          },
          "sponsorship": {
            "type": [
              "string",
              "null"
            ],
            "description": "who funds or sponsors it, if not the organiser"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
