{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:proposal",
  "title": "Proposed lecture plan for a course (course-architect output)",
  "type": "object",
  "required": ["lectures", "assumed_prerequisites", "dropped", "decisions", "rationale"],
  "additionalProperties": false,
  "properties": {
    "rationale": {"type": "string", "minLength": 1},
    "lectures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "title", "summary", "objectives", "topics"],
        "additionalProperties": false,
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "title_local": {"type": ["string", "null"], "description": "title in the course's own language"},
          "summary": {"type": "string"},
          "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "topics": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["topic", "hours", "depth"],
              "additionalProperties": false,
              "properties": {
                "topic": {"type": "string"},
                "hours": {"type": "number", "exclusiveMinimum": 0},
                "depth": {"enum": ["overview", "core", "deep"]}
              }
            }
          },
          "reuse": {
            "type": "array",
            "items": {"type": "object", "required": ["deck", "slides", "note"], "additionalProperties": false,
                      "properties": {"deck": {"type": "string"},
                                     "slides": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
                                     "note": {"type": "string"}}}
          },
          "new_material": {
            "type": "array",
            "items": {"type": "object", "required": ["what", "minutes"], "additionalProperties": false,
                      "properties": {"what": {"type": "string", "minLength": 1},
                                     "minutes": {"type": "number", "minimum": 0}}}
          }
        }
      }
    },
    "assumed_prerequisites": {"type": "array", "items": {"type": "string"}},
    "dropped": {
      "type": "array",
      "items": {"type": "object", "required": ["topic", "reason"], "additionalProperties": false,
                "properties": {"topic": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}}
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "lectures"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^D[0-9]{2}$"},
          "title": {"type": "string"},
          "summary": {"type": "string", "description": "what changes compared with the current curriculum, and why"},
          "lectures": {"type": "array", "items": {"type": "integer"}}
        }
      }
    }
  }
}
