{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:topic_map",
  "title": "Sections, named entities and content dates of one deck (topic-mapper output)",
  "type": "object",
  "required": [
    "deck",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "deck": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "slides",
          "subtopics",
          "named",
          "objectives",
          "content_date",
          "content_date_basis"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "slides": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "subtopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "named": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "enum": [
                    "system",
                    "format",
                    "api",
                    "paper",
                    "book",
                    "dataset",
                    "standard",
                    "organization",
                    "concept",
                    "other"
                  ]
                }
              }
            }
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "year of the newest version, paper or system the section names"
          },
          "content_date_basis": {
            "type": "string"
          }
        }
      }
    }
  }
}
