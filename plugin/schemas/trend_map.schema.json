{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:trend_map",
  "title": "Links from a field's trend topics to a course's topics (trend-mapper output)",
  "type": "object",
  "required": [
    "links",
    "new_topics"
  ],
  "additionalProperties": false,
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trend",
          "topic"
        ],
        "additionalProperties": false,
        "properties": {
          "trend": {
            "type": "string",
            "description": "trend topic id"
          },
          "topic": {
            "type": [
              "string",
              "null"
            ],
            "description": "course topic id (taxonomy or new topic); null if outside the course's subject"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "new_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "area",
          "depends_on",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^N[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why": {
            "type": "string",
            "description": "why no taxonomy topic covers it"
          }
        }
      }
    }
  }
}
