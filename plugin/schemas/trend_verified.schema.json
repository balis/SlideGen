{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:trend_verified",
  "title": "Verification of candidate sources: editions, volume, scope (source-verifier output)",
  "type": "object",
  "required": [
    "batch",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "batch": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "api",
          "current",
          "previous",
          "scope_fit",
          "scope_note",
          "access_note"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "api": {
            "type": "boolean",
            "description": "measured through a public API rather than downloaded pages"
          },
          "current": {
            "$ref": "#/$defs/edition"
          },
          "previous": {
            "$ref": "#/$defs/edition"
          },
          "scope_fit": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "share of items about the field, estimated from a sample; null if no items could be sampled"
          },
          "scope_note": {
            "type": "string",
            "description": "how scope_fit was estimated"
          },
          "access_note": {
            "type": "string",
            "description": "how stage 1 can harvest items (page, export, API)"
          },
          "subset_rule": {
            "type": [
              "string",
              "null"
            ],
            "description": "rule that restricts the source to its in-scope items, applied identically to both editions (track or theme labels, or item classification); items and scope_fit then refer to the subset"
          },
          "scope_sample": {
            "type": "integer",
            "minimum": 1,
            "description": "number of items sampled for scope_fit (default 20)"
          },
          "not_collectable": {
            "type": [
              "string",
              "null"
            ],
            "description": "the source has editions with item lists, but they cannot be downloaded; says why"
          },
          "collector": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": true,
            "properties": {
              "type": {
                "enum": [
                  "hn_stories",
                  "reddit",
                  "discourse",
                  "mailman3",
                  "stackexchange_tags",
                  "hn_hiring",
                  "pypi",
                  "itjobswatch",
                  "top500_list",
                  "stackoverflow_survey",
                  "survey_table"
                ]
              },
              "subreddit": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "description": "discourse: the forum's base URL"
              },
              "archive": {
                "type": "string",
                "description": "mailman3: the HyperKitty list URL, ending in /list/<name>@<host>"
              },
              "site": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "min_points": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string"
              }
            },
            "description": "for forum and adoption sources: how stage 2 measures the source (collector type and its parameters)"
          }
        }
      }
    }
  },
  "$defs": {
    "edition": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "url",
        "fetched",
        "period",
        "items",
        "items_quote"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "fetched": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?(\\.\\.\\d{4}-\\d{2}(-\\d{2})?)?$",
          "description": "date or month of the event or publication (YYYY-MM-DD or YYYY-MM; give the day when it falls in the month a window starts or ends), or the span the edition covers (start..end)"
        },
        "items": {
          "type": "integer",
          "minimum": 0,
          "description": "talks, papers, issues, episodes, or blips"
        },
        "items_quote": {
          "type": "string",
          "description": "verbatim text from the page showing it is this edition's item list"
        },
        "sample": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "an answer or an item title, exactly as printed"
              },
              "percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "a survey answer's share, exactly as printed next to it"
              }
            }
          },
          "description": "sources measured from stored pages (survey tables, lists): three rows of this edition as stage 2 will read them; sources-check finds each in the stored pages"
        },
        "more_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "fetched"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "fetched": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "description": "further pages of the same edition's item list (e.g. an industry track on a separate page)"
        }
      }
    }
  }
}
