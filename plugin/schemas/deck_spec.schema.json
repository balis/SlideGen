{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:deck_spec",
  "title": "A lecture deck as native slides on a base deck's master (sg pptx build)",
  "type": "object",
  "required": [
    "base",
    "output",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "base": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "copy": {
            "type": "integer",
            "minimum": 1,
            "description": "number of a base-deck slide to reuse"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "find",
                "replace"
              ],
              "additionalProperties": false,
              "properties": {
                "find": {
                  "type": "string"
                },
                "replace": {
                  "type": "string"
                }
              }
            }
          },
          "append_bullets": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "size": {
                      "type": "number"
                    },
                    "color": {
                      "type": "string"
                    },
                    "bold": {
                      "type": "boolean"
                    },
                    "italic": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "layout": {
            "type": "string",
            "description": "a layout of the base deck's master"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "bullets": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "size": {
                      "type": "number"
                    },
                    "color": {
                      "type": "string"
                    },
                    "bold": {
                      "type": "boolean"
                    },
                    "italic": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "bullet_size": {
            "type": "number"
          },
          "body_box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "columns": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "level": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4
                      },
                      "size": {
                        "type": "number"
                      },
                      "color": {
                        "type": "string"
                      },
                      "bold": {
                        "type": "boolean"
                      },
                      "italic": {
                        "type": "boolean"
                      }
                    }
                  }
                ]
              }
            }
          },
          "shapes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": true,
              "properties": {
                "type": {
                  "enum": [
                    "box",
                    "text",
                    "arrow",
                    "line",
                    "table"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                },
                "from": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "to": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "text": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "required": [
                              "text"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "text": {
                                "type": "string"
                              },
                              "level": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 4
                              },
                              "size": {
                                "type": "number"
                              },
                              "color": {
                                "type": "string"
                              },
                              "bold": {
                                "type": "boolean"
                              },
                              "italic": {
                                "type": "boolean"
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array"
                  }
                }
              }
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes_mode": {
            "enum": [
              "replace",
              "append"
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ids of claims the slide states"
          },
          "purpose": {
            "type": "string"
          },
          "insert": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "after",
                "lines"
              ],
              "additionalProperties": false,
              "properties": {
                "after": {
                  "type": "string",
                  "description": "text of the paragraph to insert after"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "required": [
                          "text"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "level": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4
                          },
                          "size": {
                            "type": "number"
                          },
                          "color": {
                            "type": "string"
                          },
                          "bold": {
                            "type": "boolean"
                          },
                          "italic": {
                            "type": "boolean"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "copy"
            ]
          },
          {
            "required": [
              "layout"
            ]
          }
        ]
      }
    }
  }
}
