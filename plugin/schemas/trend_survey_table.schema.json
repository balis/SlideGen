{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:trend_survey_table",
  "title": "One survey question's results in two editions (survey-extractor output)",
  "type": "object",
  "required": [
    "source",
    "question",
    "editions"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "description": "the question, the same in both editions"
    },
    "population": {
      "type": "string",
      "description": "who answered (all respondents, professionals, ...)"
    },
    "editions": {
      "type": "object",
      "required": [
        "current",
        "previous"
      ],
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "object",
          "required": [
            "fetched",
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "fetched": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "fetched ids of the stored pages the rows come from"
            },
            "period": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "percent"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "percent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "previous": {
          "type": "object",
          "required": [
            "fetched",
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "fetched": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "fetched ids of the stored pages the rows come from"
            },
            "period": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "percent"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "percent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
