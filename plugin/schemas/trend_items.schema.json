{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slidegen:trend_items",
  "title": "Every item of both editions of one panel source (harvester output)",
  "type": "object",
  "required": [
    "source",
    "parser",
    "editions"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string"
    },
    "parser": {
      "type": "string",
      "description": "path of the script that extracted the items, relative to the manifest's directory (trends/parsers/<source>.py)"
    },
    "parser_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the parser file when it wrote this file; items-check fails if the parser has changed since"
    },
    "editions": {
      "type": "object",
      "required": [
        "current",
        "previous"
      ],
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "object",
          "required": [
            "pages",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "fetched ids of the stored pages the items come from"
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "why the item count differs from the verified count, if it does"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "abstract or description, if the page has one"
                  },
                  "presenter": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "organization(s) of the presenters or authors, if the page shows them"
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "previous": {
          "type": "object",
          "required": [
            "pages",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "fetched ids of the stored pages the items come from"
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "why the item count differs from the verified count, if it does"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "abstract or description, if the page has one"
                  },
                  "presenter": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "organization(s) of the presenters or authors, if the page shows them"
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
